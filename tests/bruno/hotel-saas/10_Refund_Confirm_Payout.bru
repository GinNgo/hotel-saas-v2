meta {
  name: 10 D23 Confirm Refund Payout (Concurrency Guard)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/payments/refunds/{{refundRequestId}}/confirm-payout?propertyId={{propertyId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffJwt}}
}

headers {
  X-Property-Id: {{propertyId}}
}

script:pre-request {
  const ts = new Date().toISOString().replace(/[-:.TZ]/g, "");
  bru.setVar("bankTransactionRef", `BRUNO-REFUND-${ts}`);
}

body:json {
  {
    "payoutMethod": 3,
    "bankTransactionRef": "{{bankTransactionRef}}",
    "notes": "Disbursement verified via Bruno QA"
  }
}

tests {
  test("First payout confirms (200) and duplicate concurrent payout conflicts (409)", function() {
    expect([200, 409]).to.include(res.status);
  });
}

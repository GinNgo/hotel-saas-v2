meta {
  name: 02 - Calculate Quote
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/public/quotes/calculate
  body: json
  auth: none
}

body:json {
  {
    "propertySlug": "{{propertySlug}}",
    "roomTypeId": "{{roomTypeId}}",
    "rentalType": 3,
    "startAtUtc": "{{startAtUtc}}",
    "endAtUtc": "{{endAtUtc}}",
    "checkInDate": "{{checkInDate}}",
    "checkOutDate": "{{checkOutDate}}"
  }
}

script:pre-request {
  const now = new Date();
  const checkIn = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
  const checkOut = new Date(now.getTime() + 8 * 24 * 60 * 60 * 1000);
  const checkInDate = checkIn.toISOString().slice(0, 10);
  const checkOutDate = checkOut.toISOString().slice(0, 10);
  bru.setVar("checkInDate", checkInDate);
  bru.setVar("checkOutDate", checkOutDate);
  bru.setVar("startAtUtc", `${checkInDate}T07:00:00Z`);
  bru.setVar("endAtUtc", `${checkOutDate}T05:00:00Z`);
}

assert {
  res.status: eq 200
  res.body.totalAmount: gt 0
}

meta {
  name: 03 - Hold Anonymous Without Token (Gate Option A Rejection)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/public/bookings/hold
  body: json
  auth: none
}

body:json {
  {
    "propertySlug": "{{propertySlug}}",
    "roomTypeId": "{{roomTypeId}}",
    "rentalType": 3,
    "startAtUtc": "2026-11-20T07:00:00Z",
    "endAtUtc": "2026-11-21T05:00:00Z",
    "guestName": "Attacker Ghost",
    "guestEmail": "attacker@ghost.com",
    "guestPhone": "{{validPhone}}",
    "numberOfGuests": 2,
    "expectedTotalAmount": 3200000,
    "firebaseIdToken": null
  }
}

assert {
  res.status: eq 400
  res.body.errorCode: eq ERR_PHONE_VERIFICATION_REQUIRED
}

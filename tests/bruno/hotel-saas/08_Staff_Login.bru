meta {
  name: 08 Staff Login (Obtain Scoped JWT)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{staffEmail}}",
    "password": "{{staffPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.accessToken) {
    bru.setEnvVar("staffJwt", res.body.accessToken);
  }
}

tests {
  test("Staff login succeeds with JWT", function() {
    expect(res.status).to.equal(200);
    expect(res.body.accessToken).to.be.a("string");
  });
}

meta {
  name: 04 - Hold Anonymous With Mismatched Phone Token (Anti-Spoofing Rejection)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/public/bookings/hold
  body: json
  auth: none
}

body:json {
  {
    "propertySlug": "{{propertySlug}}",
    "roomTypeId": "{{roomTypeId}}",
    "rentalType": 3,
    "startAtUtc": "{{startAtUtc}}",
    "endAtUtc": "{{endAtUtc}}",
    "guestName": "Spoofing Guest",
    "guestEmail": "spoof@gmail.com",
    "guestPhone": "{{validPhone}}",
    "numberOfGuests": 2,
    "expectedTotalAmount": 3200000,
    "firebaseIdToken": "{{mismatchedToken}}"
  }
}

script:pre-request {
  const now = new Date();
  const checkIn = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
  const checkOut = new Date(now.getTime() + 8 * 24 * 60 * 60 * 1000);
  const checkInDate = checkIn.toISOString().slice(0, 10);
  const checkOutDate = checkOut.toISOString().slice(0, 10);
  bru.setVar("checkInDate", checkInDate);
  bru.setVar("checkOutDate", checkOutDate);
  bru.setVar("startAtUtc", `${checkInDate}T07:00:00Z`);
  bru.setVar("endAtUtc", `${checkOutDate}T05:00:00Z`);
}

assert {
  res.status: eq 400
  res.body.errorCode: eq ERR_PHONE_MISMATCH
}

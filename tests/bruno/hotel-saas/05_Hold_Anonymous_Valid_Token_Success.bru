meta {
  name: 05 - Hold Anonymous With Valid Verified Token (Gate Option A Pass)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/public/bookings/hold
  body: json
  auth: none
}

script:pre-request {
  const baseUrl = String(bru.getEnvVar("baseUrl") || "").trim().toLowerCase();
  const isLocal = baseUrl.startsWith("http://127.0.0.1") || baseUrl.startsWith("http://localhost");
  const token = String(bru.getEnvVar("validToken") || bru.getVar("validToken") || "").trim();

  if (!token || token.startsWith("<")) {
    throw new Error("ERR_MISSING_STAGING_TOKEN: Thieu bien 'validToken' (yeu cau Firebase Phone ID token khop so '{{validPhone}}'; trang thai Staging: BLOCKED/SKIPPED do khong co token OTP thuc).");
  }

  if (!isLocal && token.startsWith("dev-mock-")) {
    throw new Error("ERR_MOCK_TOKEN_FORBIDDEN_ON_STAGING: Khong duoc dung dev-mock-token tren Staging.");
  }

  const vnOffsetMs = 7 * 60 * 60 * 1000;
  const nowVn = new Date(Date.now() + vnOffsetMs);
  const checkIn = new Date(nowVn);
  checkIn.setUTCDate(checkIn.getUTCDate() + 7);
  const checkOut = new Date(checkIn);
  checkOut.setUTCDate(checkOut.getUTCDate() + 1);

  const fmtDate = (d) => d.toISOString().slice(0, 10);
  const checkInDate = fmtDate(checkIn);
  const checkOutDate = fmtDate(checkOut);
  bru.setVar("checkInDate", checkInDate);
  bru.setVar("checkOutDate", checkOutDate);
  bru.setVar("startAtUtc", `${checkInDate}T07:00:00Z`);
  bru.setVar("endAtUtc", `${checkOutDate}T05:00:00Z`);
  if (!bru.getVar("expectedTotalAmount")) {
    bru.setVar("expectedTotalAmount", 3200000);
  }
}

body:json {
  {
    "propertySlug": "{{propertySlug}}",
    "roomTypeId": "{{roomTypeId}}",
    "rentalType": 3,
    "startAtUtc": "{{startAtUtc}}",
    "endAtUtc": "{{endAtUtc}}",
    "checkInDate": "{{checkInDate}}",
    "checkOutDate": "{{checkOutDate}}",
    "guestName": "Nguyễn Văn A",
    "guestEmail": "nguyenvana@gmail.com",
    "guestPhone": "{{validPhone}}",
    "numberOfGuests": 2,
    "expectedTotalAmount": {{expectedTotalAmount}},
    "firebaseIdToken": "{{validToken}}"
  }
}

vars:post-response {
  lookupToken: res.body.lookupToken
}

assert {
  res.status: in [200, 201]
  res.body.lookupToken: isDefined
  res.body.isPhoneVerified: eq true
  res.body.holdExpiresAtUtc: isDefined
}

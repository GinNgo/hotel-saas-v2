    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cce7e490-caf7-4282-a40f-2e6c9a79d2d2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />

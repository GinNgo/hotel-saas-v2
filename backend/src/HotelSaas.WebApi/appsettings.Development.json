{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5435;Database=hotel_saas_dev_ngoc;Username=postgres;Password=postgres;Persist Security Info=true;"
  },
  "SkipStartupDatabaseInit": false,
  "JwtSettings": {
    "SecretKey": "DevOnly_SuperSecretKey_ChangeInProduction_AtLeast32Chars!",
    "Issuer": "HotelSaas",
    "Audience": "HotelSaasClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}  {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

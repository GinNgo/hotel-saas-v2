    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "panels": [],
      "title": "3. Log Lỗi & Cảnh báo gọn 1 dòng (Dành cho Vận hành viên)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Hiển thị gọn 1 dòng dễ đọc cho các lỗi (Error/Fatal) và cảnh báo (Warning), đã tự động lọc bỏ /health và /metrics. Bấm vào bất kỳ dòng nào để mở rộng JSON chi tiết hoặc bấm vào Mã tra cứu để truy vết toàn bộ request.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "id": 9,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=~\"$container\", level=~\"Error|Fatal|Warning\"} != \"/health\" != \"/metrics\" |~ \"(?i)$search\" |~ \"(?i)$endpoint\" |~ \"(?i)$tenant_id\" | json | line_format \"{{if .Level}}[{{.Level}}] {{if .Properties_StatusCode}}{{.Properties_StatusCode}} {{end}}{{if .Properties_RequestMethod}}{{.Properties_RequestMethod}} {{end}}{{if .Properties_RequestPath}}{{.Properties_RequestPath}} {{end}}{{if .Properties_ElapsedMs}}({{.Properties_ElapsedMs}}ms) {{end}}| {{or .RenderedMessage .MessageTemplate}}{{if .Properties_CorrelationId}} | Mã: {{.Properties_CorrelationId}}{{end}}{{if .Properties_ErrorCode}} | Err: {{.Properties_ErrorCode}}{{end}}{{else}}{{__line__}}{{end}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "⚠️ Log Lỗi & Cảnh báo (Dạng gọn dễ đọc)",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 103,
      "panels": [],
      "title": "4. Tra cứu Toàn bộ Log",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Dán Mã tra cứu (req-...) từ thông báo lỗi trên giao diện web, nhập từ khóa, email, đường dẫn API hoặc Mã Tenant vào thanh lọc phía trên để tra cứu. Bấm vào một dòng log để xem đầy đủ chi tiết JSON.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 26 },
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=~\"$container\", level=~\"$level\"} != \"/health\" != \"/metrics\" |~ \"(?i)$search\" |~ \"(?i)$endpoint\" |~ \"(?i)$tenant_id\" | json | line_format \"{{if .Level}}[{{.Level}}] {{if .Properties_StatusCode}}{{.Properties_StatusCode}} {{end}}{{if .Properties_RequestMethod}}{{.Properties_RequestMethod}} {{end}}{{if .Properties_RequestPath}}{{.Properties_RequestPath}} {{end}}{{if .Properties_ElapsedMs}}({{.Properties_ElapsedMs}}ms) {{end}}| {{or .RenderedMessage .MessageTemplate}}{{if .Properties_CorrelationId}} | Mã: {{.Properties_CorrelationId}}{{end}}{{if .Properties_ErrorCode}} | Err: {{.Properties_ErrorCode}}{{end}}{{else}}{{__line__}}{{end}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "🔍 Tra cứu Toàn bộ Log (Nhập Mã tra cứu req-... hoặc từ khóa ở trên)",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hotelsaas", "van-hanh", "logs", "vietnamese", "ops"],
  "templating": {
    "list": [
      {
        "allValue": ".+",

  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "1. Tổng quan nhanh (theo khung giờ đang chọn)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Kiểm tra Prometheus có đang kết nối và thu thập dữ liệu từ API Backend (HotelSaas.WebApi) hay không. 1 = Đang chạy ổn định, 0 = Mất kết nối.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 0, "text": "Mất kết nối" },
                "1": { "color": "green", "index": 1, "text": "Đang chạy" }
              },
              "type": "value"
            }
          ],
          "noValue": "Mất kết nối",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(up{job=\"hotelsaas-backend-api\"}) or vector(0)",
          "legendFormat": "API Backend",
          "refId": "A"
        }
      ],
      "title": "Trạng thái API Backend",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tổng số phản hồi lỗi máy chủ HTTP 5xx phát sinh trong khung giờ đang chọn (tính bằng increase[$__range], không cộng dồn suốt đời).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round(increase(hotelsaas_http_5xx_errors_total[$__range]) or vector(0))",
          "legendFormat": "Lỗi 5xx",
          "refId": "A"
        }
      ],
      "title": "Lỗi Hệ thống (5xx)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "95% yêu cầu API được xử lý nhanh hơn mốc thời gian này (tính theo cửa sổ 5 phút gần nhất). Dưới 500ms là nhanh, trên 1500ms cần kiểm tra hiệu năng.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 1500 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(histogram_quantile(0.95, sum(rate(hotelsaas_http_request_duration_seconds_bucket[5m])) by (le)) * 1000) or vector(0)",
          "legendFormat": "P95 (ms)",
          "refId": "A"
        }
      ],
      "title": "Độ trễ API P95 (ms)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Thống kê số lượng SePay VietQR Webhook theo từng trạng thái xử lý (confirmed, duplicate, partial, auth_failed, rejected_unconfigured_bank_account, error) trong khung giờ đang chọn.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "noValue": "0 (chưa có GD)",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "confirmed" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "displayName", "value": "Thành công" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "auth_failed" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "displayName", "value": "Sai API Key" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "rejected_unconfigured_bank_account" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "displayName", "value": "Chưa cấu hình TK" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "displayName", "value": "Lỗi xử lý" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "expired_hold_alert" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } },
              { "id": "displayName", "value": "Chuyển trễ" }
            ]
          }
        ]
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round(sum by (status) (increase(hotelsaas_sepay_webhook_total[$__range])))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "SePay Webhook (Thành công / Lỗi)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tổng số yêu cầu bị giới hạn tần suất (HTTP 429 Too Many Requests) trên các nhóm chính sách auth, webhooks, public-api, ai-chat trong khung giờ đang chọn.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round(sum(increase(hotelsaas_rate_limited_total[$__range])) or vector(0))",
          "legendFormat": "Chặn 429",
          "refId": "A"
        }
      ],
      "title": "Chặn Rate Limit (429)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tổng số yêu cầu bị từ chối xác thực hoặc phân quyền / cách ly Tenant (HTTP 401 và 403) trong khung giờ đang chọn.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round(sum(increase(hotelsaas_http_route_requests_total{status=~\"401|403\"}[$__range])) or vector(0))",
          "legendFormat": "Chặn 401/403",
          "refId": "A"
        }
      ],
      "title": "Chặn Bảo mật (401/403)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "panels": [],
      "title": "2. Biểu đồ lưu lượng & thanh toán theo thời gian",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Biểu đồ số lượng yêu cầu HTTP mỗi phút tách biệt hoàn toàn 3 nhóm 2xx (Thành công), 4xx (Lỗi phía client) và 5xx (Lỗi máy chủ) — không cộng chồng đếm trùng.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "none" }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "2xx Thành công" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "4xx Lỗi phía client" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "5xx Lỗi hệ thống" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(hotelsaas_http_route_requests_total{status=~\"2..\"}[1m]))",
          "legendFormat": "2xx Thành công",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(hotelsaas_http_route_requests_total{status=~\"4..\"}[1m]))",
          "legendFormat": "4xx Lỗi phía client",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(hotelsaas_http_route_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "5xx Lỗi hệ thống",
          "refId": "C"
        }
      ],
      "title": "Lưu lượng Request & Lỗi theo phút",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Số lượng giao dịch SePay VietQR Webhook mỗi 5 phút chia theo trạng thái xử lý (confirmed, partial, duplicate, ignored, expired_hold_alert, auth_failed, rejected_unconfigured_bank_account, error).",
      "fieldConfig": {

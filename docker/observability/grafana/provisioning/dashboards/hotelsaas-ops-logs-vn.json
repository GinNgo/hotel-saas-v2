        "definition": "label_values(container)",
        "hide": 0,
        "includeAll": true,
        "label": "Dịch vụ (Container)",
        "multi": true,
        "name": "container",
        "options": [],
        "query": "label_values(container)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "selected": true,
          "text": "Tất cả",
          "value": "Error|Fatal|Warning|Information"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Mức độ Log",
        "multi": false,
        "name": "level",
        "options": [
          { "selected": true, "text": "Tất cả", "value": "Error|Fatal|Warning|Information" },
          { "selected": false, "text": "Chỉ Lỗi & Nghiêm trọng", "value": "Error|Fatal" },
          { "selected": false, "text": "Lỗi & Cảnh báo", "value": "Error|Fatal|Warning" },
          { "selected": false, "text": "Thông tin", "value": "Information" },
          { "selected": false, "text": "Toàn bộ Container (gồm Nginx/Caddy)", "value": ".*" }

        {
          "datasource": "Prometheus",
          "expr": "sum by (error_code) (increase(hotelsaas_tenant_isolation_blocks_by_reason_total[5m]))",
          "legendFormat": "{{error_code}}",
          "refId": "B"
        }
      ]
    },

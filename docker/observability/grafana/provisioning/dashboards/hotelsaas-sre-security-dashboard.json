        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "HTTP RPS by Route & Status & 5xx Rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (method, route, status) (rate(hotelsaas_http_route_requests_total[1m]))",
          "legendFormat": "{{method}} {{route}} [{{status}}]",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(hotelsaas_http_5xx_errors_total[1m])",
          "legendFormat": "HTTP 5xx Error Rate",
          "refId": "B"
        }
      ]
    },

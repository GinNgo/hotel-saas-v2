            "lineWidth": 1,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "links": [
            {
              "targetBlank": false,
              "title": "Xem Log Chặn Bảo mật chi tiết",
              "url": "/grafana/d/hotelsaas-ops-logs-vn?from=${__from}&to=${__to}"
            }

    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Hiển thị tất cả log mức Error, Fatal, Warning hoặc phản hồi HTTP >= 400 (đã loại trừ /health và /metrics, tìm kiếm không phân biệt hoa thường).",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 19 },
      "id": 9,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=~\"$container\"} != \"/health\" != \"/metrics\" |~ \"(?i)$tenant_id\" |~ \"(?i)$property_id\" |~ \"(?i)$search\" | json CorrelationId=\"Properties.CorrelationId\", TenantId=\"Properties.TenantId\", PropertyId=\"Properties.PropertyId\", StatusCode=\"Properties.StatusCode\", ElapsedMs=\"Properties.ElapsedMs\", ErrorCode=\"Properties.ErrorCode\", SourceContext=\"Properties.SourceContext\" | level=~\"Error|Fatal|Warning\" or StatusCode >= 400",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "⚠️ Log Lỗi & Chặn Bảo mật (Error / Fatal / Warning / Status >= 400)",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Hiển thị toàn bộ nhật ký JSON có cấu trúc theo dịch vụ, mức độ log, Mã Tenant, Mã Chi nhánh và từ khóa không phân biệt chữ hoa/thường.",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 28 },
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=~\"$container\", level=~\"$level\"} != \"/health\" != \"/metrics\" |~ \"(?i)$tenant_id\" |~ \"(?i)$property_id\" |~ \"(?i)$search\" | json CorrelationId=\"Properties.CorrelationId\", TenantId=\"Properties.TenantId\", PropertyId=\"Properties.PropertyId\", StatusCode=\"Properties.StatusCode\", ElapsedMs=\"Properties.ElapsedMs\", RequestPath=\"Properties.RequestPath\", ErrorCode=\"Properties.ErrorCode\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "📋 Toàn bộ Structured JSON Logs (Lọc theo thanh chọn ở trên)",
      "type": "logs"
    }
  ],

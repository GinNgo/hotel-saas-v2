      "title": "⚠️ Log Lỗi & Chặn Bảo Mật (Error / Warning / Status >= 400)",
      "type": "logs",
      "targets": [
        {
          "datasource": "Loki (Structured Logs)",
          "expr": "{container=~\"$container\", tenant_id=~\"$tenant_id\", property_id=~\"$property_id\"} |= \"$search\" | json CorrelationId=\"Properties.CorrelationId\", TenantId=\"Properties.TenantId\", PropertyId=\"Properties.PropertyId\", StatusCode=\"Properties.StatusCode\", ElapsedMs=\"Properties.ElapsedMs\", ErrorCode=\"Properties.ErrorCode\", SourceContext=\"Properties.SourceContext\" | level=~\"Error|Warning\" or StatusCode >= 400",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },

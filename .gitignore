# ══════════════════════════════════════════════════════════════════
# Hotel SaaS Platform — Root .gitignore
# ══════════════════════════════════════════════════════════════════

# ── .NET ──
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/**/*.suo
backend/**/.vs/
*.nupkg

# ── Node / Angular ──
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/

# ── Environment & Secrets ──
.env
.env.*
!.env.example
**/appsettings.*.json
!**/appsettings.json
!**/appsettings.Development.json

# ── Docker ──
docker/data/

# ── IDE & Editor ──
.vs/
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS Generated ──
.DS_Store
Thumbs.db
Desktop.ini

# ── Scripts build artifacts ──
scripts/**/bin/
scripts/**/obj/

# ── Logs & Archives ──
*.log
logs/
*.zip
*.tar.gz
*.7z

# ── Local handoff packages & Teammate workspaces ──
team-handoff/
team-handoff*.zip
docs/team-handoff-package.md
docs/team/handoff/
docs/team/members/
docs/team/guides/
docs/team/assets/
hotel-members-tasks/
members-tasks/

# ── AI Agent Tooling & Coordination ──
.gemini/
.agents/
docs/agent-coordination/
docs/prompts/
docs/agent-logs/

# ── Scratch, Drafts & Ad-hoc Testing Scripts ──
*.py
scratch/
temp/
screenshots/
scripts/test-*.js
scripts/temp/

# ── Redundant / Draft Documentation ──
docs/specs/
docs/scratch/
docs/drafts/
docs/**/drafts/
docs/weekly-reports/
*CHAM_DIEM*
*cham-diem*
*self-assessment*
